{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TwilioDevKit": {
    "Enabled": true,
    "DefaultAction": "Simulate",
    "DefaultCountry": "AU",
    "AllowedNumbers": [],
    "Rules": [
      {
        "Match": "+61411111111",
        "Action": "Fail",
        "ErrorCode": 21610,
        "Note": "Unsubscribed recipient - checks our opt-out handling"
      },
      {
        "Match": "+61422222222",
        "Action": "Fail",
        "ErrorCode": 30003,
        "Note": "Handset unreachable - fails on the delivery receipt, not the send"
      },
      {
        "Match": "country:AU",
        "Action": "MapToTestNumber",
        "Note": "Exercise the real API with test credentials"
      }
    ],
    "StatusCallbacks": {
      "Enabled": true,
      "Sequence": [
        "queued",
        "sent",
        "delivered"
      ],
      "DelayMs": 900
    },
    "Inspector": {
      "Enabled": true,
      "Path": "/_twilio",
      "AllowRuntimeChanges": true
    }
  }
}
