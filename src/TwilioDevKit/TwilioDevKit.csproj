<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <PackageId>TwilioDevKit</PackageId>
    <Version>1.0.0</Version>
    <Authors>Platform Engineering</Authors>
    <Description>
      Test Twilio SMS against any phone number without Twilio's magic-number restriction,
      and record every message your application sends for inspection.
    </Description>
    <PackageTags>twilio;sms;testing;sandbox;test-credentials;magic-numbers</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Twilio 7.x only ships a net6.0 target, so netstandard2.0 consumers need 8.x.
    Applications already on Twilio 7 can still use this package on net6.0+.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <PackageReference Include="Twilio" Version="[7.0.0,9.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Twilio" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
